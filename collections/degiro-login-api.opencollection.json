{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unofficial Degiro config login API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "sessionId",
      "value": "{{sessionId}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Logs in",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://trader.degiro.nl/login/secure/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Logs in and returns the sessionId"
        }
      ]
    }
  ],
  "bundled": true
}