{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unofficial Degiro config API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "sessionId",
      "value": "{{sessionId}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns the config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://trader.degiro.nl/login/secure/config"
          },
          "docs": "Returns the config"
        }
      ]
    }
  ],
  "bundled": true
}