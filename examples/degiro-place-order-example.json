    "headers": {
      "Content-Type": "application/json"
    },
    "queryParams": {
      "intAccount": "12345678",
      "sessionId": "ABCDEF1234567890ABCDEF1234567890.prod_b_112_2"
    },
    "body": {
      "buySell": "BUY",
      "orderType": 0,
      "productId": 332111,
      "size": 10,
      "price": 42.50,
      "timeType": 1
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
